# Copy to .env.<profile>.local and replace every placeholder.
# Never commit the profile-local file.

LITELLM_MASTER_KEY=replace-me
JWT_SECRET=replace-with-64-hex-characters
JWT_REFRESH_SECRET=replace-with-64-hex-characters
CREDS_KEY=replace-with-64-hex-characters
CREDS_IV=replace-with-32-hex-characters

LIBRECHAT_ALLOW_REGISTRATION=false
LIBRECHAT_DEBUG_LOGGING=false
