# Copy to .env.<profile>.local only when the Bitwarden-backed source is
# unavailable. Never commit the profile-local file.

# Gateway root credential. Administrative use only.
LITELLM_MASTER_KEY=replace-with-sk-prefixed-master-key

# Durable encryption key for LiteLLM database-backed credentials.
# Losing or changing this may make persisted credentials unreadable.
LITELLM_SALT_KEY=replace-with-sk-prefixed-salt-key

# Use a URI-safe value. A 64-character hexadecimal value is suitable.
LITELLM_DATABASE_PASSWORD=replace-with-64-hex-characters
