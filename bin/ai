#!/usr/bin/env bash
set -euo pipefail

AI_LAB_ROOT="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1
  pwd
)"

source "${AI_LAB_ROOT}/tools/ai/env.sh"
source "${AI_LAB_ROOT}/tools/ai/runtime.sh"
source "${AI_LAB_ROOT}/tools/ai/prompt.sh"
source "${AI_LAB_ROOT}/tools/ai/routes.sh"
source "${AI_LAB_ROOT}/tools/ai/history.sh"
source "${AI_LAB_ROOT}/tools/ai/gateway.sh"
source "${AI_LAB_ROOT}/tools/ai/commands.sh"

cmd="${1:-}"

case "$cmd" in
  "")
    command_default
    ;;
  ask)
    shift
    command_ask "$@"
    ;;
  fast)
    shift
    command_fast "$@"
    ;;
  capable)
    shift
    command_capable "$@"
    ;;
  code)
    shift
    command_code "$@"
    ;;
  routes)
    shift
    command_routes "$@"
    ;;
  status)
    shift
    command_status "$@"
    ;;
  history)
    shift
    command_history "$@"
    ;;
  feedback)
    shift
    command_feedback "$@"
    ;;
  profile)
    shift
    command_profile "$@"
    ;;
  down)
    shift
    command_down "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    unknown_command "$cmd"
    ;;
esac
